@startuml
title Buffer Manager & Global Buffer Pool

skinparam {
    shadowing false
    ArrowColor #555555
    ParticipantFontSize 12
    NoteFontSize 11
}

actor "Client Query" as Client
participant "Buffer Manager" as BM
participant "Table Manager" as TM
participant "Global Buffer Pool" as GP
participant "Page Map\n(FileID,PageID -> Frame)" as PT
participant "LRU List" as LRU
participant "Free List" as FreeList
participant "Frame" as Frame
participant "FileManager" as FM
participant "WAL Logger" as WAL
database "Disk (table.db)" as Disk
database "WAL File" as WALFile

note right of GP
  One shared GlobalPool serves every table.
  Frames keep:
    - FileID + PageID
    - dirty flag / pin count
    - writer closure bound to the FileManager
  Eviction/WAL logic is centralized so all
  storage engines observe the same cache.
end note

note right of FreeList
  Frames are preallocated. Misses use
  the free list first; afterwards evicted
  frames are recycled.
end note

== Load Page ==

Client -> BM: GetPage(schema, table, pid)
BM -> TM: OpenTable(schema, table)
TM --> BM: (FileID, *FileManager)
BM -> GP: GetPage(fid, pid,\nreader=fm.ReadPage,\nwriter=fm.WritePage)
GP -> PT: Lookup (fid,pid)

alt Cache Hit
    PT --> GP: frame
    GP -> Frame: pinCnt++
    GP -> LRU: MoveToFront(frame)
    GP --> BM: *page.Page
else Cache Miss
    PT --> GP: missing
    alt FreeList available
        GP -> FreeList: Pop frame
    else Need eviction
        GP -> LRU: pick tail
        loop until frame unpinned
            alt frame pinned
                LRU --> GP: pinCnt > 0
                GP -> LRU: continue
            else unpinned
                alt Dirty
                    GP -> WAL: Append(fid,pid,data)
                    WAL -> WALFile: append
                    GP -> Frame: call writer(Page)\n(write via FileManager)
                else Clean
                    GP -> GP: reuse directly
                end
                GP -> PT: Remove (fid,pid)
                GP -> LRU: Remove node
                GP -> Frame: Reset metadata
                break
            end
        end
    end

    GP -> FM: reader(pid)
    FM -> Disk: read block
    Disk --> FM: bytes
    FM --> GP: *page.Page

    GP -> Frame: assign page, fid, pid,\npinCnt=1, Dirty=false,\nwriter=FM.WritePage
    GP -> LRU: Insert at front
    GP -> PT: Insert (fid,pid) -> frame
    GP --> BM: *page.Page
end

BM --> Client: page pointer

== Mark Dirty / Unpin ==

Client -> BM: Unpin(schema, table, pid, dirty?)
BM --> GP: Unpin(fid, pid, dirty)
GP -> Frame: pinCnt--\nDirty |= dirty

Client -> BM: MarkDirty(schema, table, pid)
BM -> GP: MarkDirty(fid, pid)

== Flush ==

Client -> BM: FlushTable(schema, table)
BM -> GP: FlushMatching(filter=fid,\nwrite=fm.WritePage,\nsync=fm.Sync)
loop for each dirty frame matching fid
    GP -> WAL: Append(fid,pid,data)
    WAL -> WALFile: append
    GP -> GP: WAL.Sync once
    GP -> Frame: writer(Page)\n(write via FileManager)
end
GP -> FM: Sync()

Client -> BM: FlushAll()
BM -> GP: FlushMatching(filter=nil,\nwrite=Lookup(fid).WritePage,\nsync=Lookup(fid).Sync)

@enduml
